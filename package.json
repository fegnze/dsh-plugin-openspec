{
  "name": "dsh-openspec",
  "version": "0.1.1",
  "license": "MIT",
  "author": "fegnze",
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fegnze/dsh-openspec.git"
  },
  "homepage": "https://github.com/fegnze/dsh-openspec#readme",
  "bugs": {
    "url": "https://github.com/fegnze/dsh-openspec/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "OpenSpec 会话项目规范与变更管理",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/zh.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  }
}
